# Copy to .env (which is gitignored) and fill in.
# Never commit .env. Never paste these values into a chat.

# --- Quick one-off run: paste an access token from the OAuth 2.0 Playground.
#     Expires in ~1 hour. Fine for today; useless for a daily job.
GHEALTH_ACCESS_TOKEN=

# --- Repeatable runs: from your Google Cloud OAuth client + the Playground's
#     "Exchange authorization code for tokens" step.
#     NOTE: while the OAuth app's publishing status is "Testing", this refresh
#     token expires after 7 DAYS (ARCHITECTURE.md OQ-5).
GHEALTH_CLIENT_ID=
GHEALTH_CLIENT_SECRET=
GHEALTH_REFRESH_TOKEN=

# --- Hevy (requires Hevy Pro): https://hevy.com/settings?developer
HEVY_API_KEY=

# --- Google Sheet mirror, for the Claude Project (optional).
#     Set ENABLED to any non-empty value to turn it on. Leave SHEET_ID blank
#     on first run: the pipeline creates the sheet and prints the id to save.
#     Requires the drive.file scope on the refresh token.
COACH_SYNC_SHEET_ENABLED=
COACH_SYNC_SHEET_ID=

# --- A SECOND refresh token, drive.file scope ONLY, from the same OAuth client.
#     It must be separate: the Google Health API returns 403
#     DISALLOWED_OAUTH_SCOPES for any token that also carries a Drive scope.
#     Authorise twice in the Playground — once per scope family.
GSHEETS_REFRESH_TOKEN=
