# Copy to .env (which is gitignored) and fill in.
# Never commit .env. Never paste these values into a chat.

# --- Quick one-off run: paste an access token from the OAuth 2.0 Playground.
#     Expires in ~1 hour. Fine for today; useless for a daily job.
GHEALTH_ACCESS_TOKEN=

# --- Repeatable runs: from your Google Cloud OAuth client + the Playground's
#     "Exchange authorization code for tokens" step.
#     NOTE: while the OAuth app's publishing status is "Testing", this refresh
#     token expires after 7 DAYS (ARCHITECTURE.md OQ-5).
GHEALTH_CLIENT_ID=
GHEALTH_CLIENT_SECRET=
GHEALTH_REFRESH_TOKEN=

# --- Hevy (requires Hevy Pro): https://hevy.com/settings?developer
HEVY_API_KEY=
